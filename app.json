{
  "expo": {
    "name": "Projex Plan",
    "slug": "projex-plan",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jacarandalab.projexplan"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.jacarandalab.projexplan"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      [
        "expo-image-picker",
        {
          "photosPermission": "Projex Plan necesita acceso a tus fotos.",
          "cameraPermission": "Projex Plan necesita acceso a tu cámara."
        }
      ],
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Projex Plan usa tu ubicación para geoetiquetar fotos."
        }
      ]
    ],
    "scheme": "projexplan",
    "experiments": {
      "typedRoutes": true
    }
  }
}
