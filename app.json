{
  "expo": {
    "name": "Projex Plan",
    "slug": "projex-plan",
    "version": "1.2.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0A0A0A"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.jacarandalab.projexplan",
      "buildNumber": "5",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "Projex Plan usa tu ubicación para el mapa de sitio del proyecto.",
        "NSLocationAlwaysUsageDescription": "Projex Plan usa tu ubicación para el mapa de sitio del proyecto.",
        "NSCameraUsageDescription": "Projex Plan necesita acceso a tu cámara para tomar fotos de obra.",
        "NSPhotoLibraryUsageDescription": "Projex Plan necesita acceso a tus fotos para subir documentos y planos.",
        "NSPhotoLibraryAddUsageDescription": "Projex Plan necesita guardar capturas del mapa de sitio.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0A0A0A"
      },
      "package": "com.jacarandalab.projexplan",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCCqkdLCalzM12JPIeWVSigFspv5gkGCyU"
        }
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "plugins": [
      "expo-router",
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#FFD700",
          "sounds": [],
          "mode": "production"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Projex Plan necesita acceso a tus fotos para subir documentos y planos.",
          "cameraPermission": "Projex Plan necesita acceso a tu cámara para tomar fotos de obra."
        }
      ],
      "expo-document-picker",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Projex Plan usa tu ubicación para geoetiquetar fotos."
        }
      ],
      "@react-native-community/datetimepicker"
    ],
    "scheme": "projexplan",
    "newArchEnabled": true,
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "56704678-54ec-478c-8060-e95d24df3caa"
      }
    },
    "owner": "edgar_conrado"
  }
}
